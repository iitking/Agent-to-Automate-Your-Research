APP_ENV=development
APP_NAME=ResearchAgent
LOG_LEVEL=INFO

# LLM Provider: gemini, openai, or ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Web Search APIs
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Academic APIs (arXiv is free without API key; Semantic Scholar has free rate limits or optional key)
SEMANTIC_SCHOLAR_API_KEY=

# Database
# Default SQLite for instant local zero-dependency runs:
DATABASE_URL=sqlite+aiosqlite:///./research.db
# Or PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_db

# Redis (optional for celery worker; built-in async worker active by default)
REDIS_URL=redis://localhost:6379/0

# Research limits
MAX_RESEARCH_ITERATIONS=3
MAX_SEARCH_QUERIES=15
MAX_SOURCES=20

# Network and extraction
REQUEST_TIMEOUT=30
MAX_DOCUMENT_SIZE_MB=15
